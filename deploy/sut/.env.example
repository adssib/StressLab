# Copy to .env (gitignored) and fill in. Never commit the real file.
POSTGRES_PASSWORD=change-me
# At least 32 characters. The conformance suite needs the same value.
STRESSLAB_TOKEN_KEY=change-me-to-at-least-32-random-characters
# Image tag to run; CI tags images by git commit (ROADMAP 0.11).
TAG=dev
